{
  "name": "trama",
  "version": "0.1.0",
  "description": "Local-first AI for conversing with your vault through Voce, discovering related notes through Filo, and searching indexed notes through Lente.",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "install:plugin": "npm run build && node scripts/install-plugin.mjs",
    "format": "prettier --write '**/*.{js,mjs,ts,json,md}'",
    "format:check": "prettier --check '**/*.{js,mjs,ts,json,md}'",
    "lint": "eslint .",
    "test": "vitest run",
    "taladb:gate0": "TMPDIR=$PWD/candidate/taladb/.generated/tmp PLAYWRIGHT_BROWSERS_PATH=$PWD/candidate/taladb/.generated/playwright-browsers node scripts/taladb-gate0.mjs",
    "taladb:browser": "npm run taladb:gate0",
    "taladb:native": "TRAMA_TALADB_GENERATED=$PWD/benchmarks/taladb/.generated TMPDIR=$PWD/benchmarks/taladb/.generated/tmp node scripts/taladb-native-lifecycle.mjs",
    "artifact:verify": "node scripts/verify-plugin-artifact.mjs",
    "taladb:benchmark": "TRAMA_TALADB_GENERATED=$PWD/benchmarks/taladb/.generated TMPDIR=$PWD/benchmarks/taladb/.generated/tmp node scripts/taladb-benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@taladb/web": "0.11.3",
    "taladb": "0.11.3"
  }
}
