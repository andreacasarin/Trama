{
  "name": "trama",
  "version": "0.1.0",
  "description": "Local-first AI for conversing with your vault through Voce and discovering related notes through Filo.",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "install:plugin": "npm run build && node scripts/install-plugin.mjs",
    "format": "prettier --write '**/*.{js,mjs,ts,json,md}'",
    "format:check": "prettier --check '**/*.{js,mjs,ts,json,md}'",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18"
  }
}
